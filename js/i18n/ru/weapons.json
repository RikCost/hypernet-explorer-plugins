  "541": {
    "name": "Акустика уличного музыканта",
    "description": "Побитая дредноут-гитара с тремя оставшимися струнами, за которую хватаются за гриф."
  },
  "542": {
    "name": "Президентский саксофон",
    "description": "Медный теноровый саксофон, звучавший в ночном эфире и взлетающий в воздух, когда вопросы становятся сложнее."
  },
  "543": {
    "name": "Стратокастер из ломбарда",
    "description": "Копия копии, купленная с рук и так и не настроенная до конца."
  },
  "544": {
    "name": "Адская гитара",
    "description": "Суперстрат с вишнёвой отделкой, стёганым узором и зубцами акулы. Громче комнаты и горячее усилителя."
  },
  "545": {
    "name": "Летающая V",
    "description": "Гитара в форме того, для чего её используют. Тут объяснять дважды не приходится."
  },
  "546": {
    "name": "Бас-гитара",
    "description": "Четыре струны, длинный гриф и большая масса. Низкие частоты скорее чувствуешь, чем слышишь."
  },
  "547": {
    "name": "Двухгрифовый боевой конь",
    "description": "Двенадцать струн сверху, шесть снизу и ремень, выдержавший больше, чем должен выдерживать любой ремень."
  },
  "548": {
    "name": "Пушка обратной связи",
    "description": "Гитара, напрямую подключённая к стеку усилителей, которого уже нет. Она всё ещё воет."
  },
  "549": {
    "name": "Суперстрат адского пламени",
    "description": "Гриф тянется во всю длину корпуса, а сам корпус горит с того дня, как на него натянули струны."
  },
  "550": {
    "name": "Адский посох",
    "description": "Трость джентльмена с рукоятью-черепом. В стержне спрятаны ножны, а то, что они скрывают, не отличается учтивостью."
  }
}